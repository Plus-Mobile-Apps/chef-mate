-- Many-to-many join between Recipe and RecipeBook: a recipe can live in several books.
-- Mirrors the RecipeCategory junction.

CREATE TABLE RecipeBookRecipe (
    recipeBookId INTEGER NOT NULL,
    recipeId INTEGER NOT NULL,
    PRIMARY KEY (recipeBookId, recipeId),
    FOREIGN KEY (recipeBookId) REFERENCES RecipeBook(id) ON DELETE CASCADE,
    FOREIGN KEY (recipeId) REFERENCES Recipe(id) ON DELETE CASCADE
);

CREATE INDEX idx_recipe_book_recipe_recipe ON RecipeBookRecipe(recipeId);

attach:
INSERT OR IGNORE INTO RecipeBookRecipe (recipeBookId, recipeId) VALUES (?, ?);

detach:
DELETE FROM RecipeBookRecipe WHERE recipeBookId = ? AND recipeId = ?;

detachAllForRecipe:
DELETE FROM RecipeBookRecipe WHERE recipeId = ?;

getBookIdsForRecipe:
SELECT recipeBookId FROM RecipeBookRecipe WHERE recipeId = ?;

getRecipeIdsForBook:
SELECT recipeId FROM RecipeBookRecipe WHERE recipeBookId = ?;

countByBook:
SELECT recipeBookId, COUNT(*) AS recipeCount
FROM RecipeBookRecipe
GROUP BY recipeBookId;

-- Drops the local copies of recipes that only reach the user through :recipeBookId — filed in no
-- other local book and authored by someone else — e.g. once the user loses access to a family
-- book. The user's own recipes are kept; callers refile them.
deleteForeignRecipesOnlyInBook:
DELETE FROM Recipe
WHERE id IN (SELECT recipeId FROM RecipeBookRecipe WHERE recipeBookId = :recipeBookId)
  AND id NOT IN (SELECT recipeId FROM RecipeBookRecipe WHERE recipeBookId != :recipeBookId)
  AND ownerId IS NOT NULL AND ownerId != :userId;

-- Files the recipes that live only in :recipeBookId under :targetBookId too, so they still have a
-- book once :recipeBookId goes away.
refileRecipesOnlyInBook:
INSERT OR IGNORE INTO RecipeBookRecipe (recipeBookId, recipeId)
SELECT :targetBookId, recipeId FROM RecipeBookRecipe
WHERE recipeBookId = :recipeBookId
  AND recipeId NOT IN (SELECT recipeId FROM RecipeBookRecipe WHERE recipeBookId != :recipeBookId);
