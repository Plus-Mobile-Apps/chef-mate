import kotlin.Boolean;

CREATE TABLE Recipe (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT,
    ingredients TEXT,
    directions TEXT,
    imageUrl TEXT,
    sourceUrl TEXT,
    servings INTEGER,
    prepTime INTEGER,
    cookTime INTEGER,
    totalTime INTEGER,
    calories INTEGER,
    starRating INTEGER,
    isFavorite INTEGER AS Boolean NOT NULL DEFAULT 0,
    createdAt TEXT NOT NULL DEFAULT (datetime('now')),
    updatedAt TEXT NOT NULL DEFAULT (datetime('now')),
    remoteId TEXT UNIQUE,
    clientId TEXT,
    isDirty INTEGER AS Boolean NOT NULL DEFAULT 0,
    ownerId TEXT,
    isPendingDelete INTEGER AS Boolean NOT NULL DEFAULT 0,
    isPublic INTEGER AS Boolean NOT NULL DEFAULT 0
);

getAll:
SELECT * FROM Recipe WHERE isPendingDelete = 0 ORDER BY title DESC;

getAllForBook:
SELECT Recipe.* FROM Recipe
INNER JOIN RecipeBookRecipe ON Recipe.id = RecipeBookRecipe.recipeId
WHERE Recipe.isPendingDelete = 0 AND RecipeBookRecipe.recipeBookId = ?
ORDER BY Recipe.title DESC;

getById:
SELECT * FROM Recipe WHERE id = ?;

create:
INSERT INTO Recipe (title, description, ingredients, directions, imageUrl, sourceUrl, servings, prepTime, cookTime, totalTime, calories, starRating, isFavorite, createdAt, updatedAt, clientId, ownerId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

createWithRemoteId:
INSERT INTO Recipe (title, description, ingredients, directions, imageUrl, sourceUrl, servings, prepTime, cookTime, totalTime, calories, starRating, isFavorite, createdAt, updatedAt, remoteId, clientId, ownerId, isPublic)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(remoteId) DO UPDATE SET
    title = excluded.title,
    description = excluded.description,
    ingredients = excluded.ingredients,
    directions = excluded.directions,
    imageUrl = excluded.imageUrl,
    sourceUrl = excluded.sourceUrl,
    servings = excluded.servings,
    prepTime = excluded.prepTime,
    cookTime = excluded.cookTime,
    totalTime = excluded.totalTime,
    calories = excluded.calories,
    starRating = excluded.starRating,
    isFavorite = excluded.isFavorite,
    updatedAt = excluded.updatedAt,
    clientId = excluded.clientId,
    ownerId = excluded.ownerId,
    isPublic = excluded.isPublic;

lastInsertId:
SELECT MAX(id) FROM Recipe;

update:
UPDATE Recipe SET title = ?, description = ?, ingredients = ?, directions = ?, imageUrl = ?, sourceUrl = ?, servings = ?, prepTime = ?, cookTime = ?, totalTime = ?, calories = ?, starRating = ?, isFavorite = ?, updatedAt = ?, isDirty = 1
WHERE id = ?;

updateFromRemote:
UPDATE Recipe SET title = ?, description = ?, ingredients = ?, directions = ?, imageUrl = ?, sourceUrl = ?, servings = ?, prepTime = ?, cookTime = ?, totalTime = ?, calories = ?, starRating = ?, isFavorite = ?, isPublic = ?, ownerId = ?, updatedAt = ?
WHERE id = ?;

delete:
DELETE FROM Recipe WHERE id = ?;

deleteAll:
DELETE FROM Recipe;

getByRemoteId:
SELECT * FROM Recipe WHERE remoteId = ?;

getByClientId:
SELECT * FROM Recipe WHERE clientId = ?;

getUnsynced:
SELECT * FROM Recipe WHERE remoteId IS NULL AND isPendingDelete = 0;

getDirty:
SELECT * FROM Recipe WHERE isDirty = 1 AND remoteId IS NOT NULL AND isPendingDelete = 0;

markPendingDelete:
UPDATE Recipe SET isPendingDelete = 1, isDirty = 0 WHERE id = ?;

getPendingDeletes:
SELECT * FROM Recipe WHERE isPendingDelete = 1 AND remoteId IS NOT NULL;

setPublic:
UPDATE Recipe SET isPublic = ?, isDirty = 1, updatedAt = ? WHERE id = ?;

updateRemoteId:
UPDATE Recipe SET remoteId = ?, isDirty = 0 WHERE id = ?;

updateClientId:
UPDATE Recipe SET clientId = ? WHERE id = ?;

clearDirty:
UPDATE Recipe SET isDirty = 0 WHERE id = ?;

markDirty:
UPDATE Recipe SET isDirty = 1, updatedAt = ? WHERE id = ?;

-- Cleanly-synced recipes the current user owns. A NULL ownerId means the row was created on
-- this device and never re-pulled, which also means it's the user's own. Recipes shared via a
-- book always carry the sharer's ownerId, so they can never match. Dirty rows are excluded so an
-- unpushed local edit is never pruned away.
getOwnedSyncedRemoteIds:
SELECT id, remoteId FROM Recipe
WHERE remoteId IS NOT NULL AND isDirty = 0 AND isPendingDelete = 0
  AND (ownerId IS NULL OR ownerId = ?);

getRecipeIdsWithoutBook:
SELECT Recipe.id FROM Recipe
LEFT JOIN RecipeBookRecipe ON Recipe.id = RecipeBookRecipe.recipeId
WHERE RecipeBookRecipe.recipeId IS NULL AND Recipe.isPendingDelete = 0;
