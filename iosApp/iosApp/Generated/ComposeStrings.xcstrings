          "stringUnit" : { "state" : "translated", "value" : "Back" }
        }
      }
    },
    "onboarding_cook_mode_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "When you’re ready to cook, tap Start Cooking in the toolbar for a distraction-free, step-by-step view. Text stays large and your screen won’t dim, so you can keep both hands on the food." }
        }
      }
    },
    "onboarding_cook_mode_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Start cooking, hands-free" }
        }
      }
    },
    "onboarding_family_sharing_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Start a family from Manage Family in the More tab and invite the people you cook with. Plan meals together on a family meal plan, shop from the same family grocery lists, and collect everyone’s favorites in family recipe books — changes show up for the whole family." }
        }
      }
    },
    "onboarding_family_sharing_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Plan, shop, and cook as a family" }
        }
      }
    },
    "onboarding_grocery_lists_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Keep more than one grocery list — one for the week, one for a party, one for the hardware run. Share a list with family or roommates and everyone’s changes stay in sync as you shop." }
        }
      }
    },
    "onboarding_grocery_lists_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Shop together with shared lists" }
        }
      }
    },
    "onboarding_meal_planning_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Tap the calendar in the recipe toolbar to drop a recipe onto any day of the week. Map out breakfast, lunch, and dinner so there’s never a question of what’s for dinner." }
        }
      }
    },
    "onboarding_meal_planning_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Add it to your meal plan" }
        }
      }
    },
    "onboarding_next" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Next" }
        }
      }
    },
    "onboarding_recipe_books_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Group your recipes into as many books as you like — weeknight dinners, holiday baking, family favorites. Share a book with friends and family so everyone can cook from the same collection." }
        }
      }
    },
    "onboarding_recipe_books_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Organize with recipe books" }
        }
      }
    },
    "onboarding_save_recipes_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Prefer to stay in the app? Open the built-in browser to search the web for recipes. When you land on one you like, tap Download and ChefMate saves the ingredients, steps, and photo directly to your account." }
        }
      }
    },
    "onboarding_save_recipes_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Or search without leaving ChefMate" }
        }
      }
    },
    "onboarding_share_recipes_message_desktop" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "Found a recipe out on the web? Copy its address from your browser’s address bar and paste it into ChefMate. It pulls in the photo, ingredients, and steps automatically — no copying and pasting the page." }
        }
      }
    },
    "onboarding_share_recipes_message_mobile" : {
      "extractionState" : "manual",
